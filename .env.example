# Porta HTTP do servidor
PORT=3000
# Caminho do banco SQLite (persistente). Em Docker, use um volume em /app/data
DATABASE_PATH=./data/tocatas.db
# "production" ativa cookies Secure (exige HTTPS)
NODE_ENV=production
# Defina como 1 se estiver atrás de proxy reverso (Nginx, Render, Railway...)
TRUST_PROXY=1
# Usuário administrador criado automaticamente no primeiro start (se não houver usuários)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=troque-esta-senha
ADMIN_NAME=Administrador
# Contato exigido pelo protocolo Web Push (mailto: ou https:)
VAPID_SUBJECT=mailto:p1.banda@exemplo.com
# Fuso horário dos eventos (Maranhão: UTC-3, sem horário de verão)
TZ_OFFSET=-03:00
